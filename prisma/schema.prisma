
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum Role {
  USER
  SUPER_ADMIN
  WORKER
  ADMIN
}

model User {
  id                 String   @id
  mobile             String   @unique
  firstName          String?
  lastName           String?
  gender             String?
  dateOfBirth        DateTime?
  country            String?
  state              String?
  district           String?
  branch             String? // village / town / area
  latitude           Float?
  longitude          Float?
  profileImage       String? // GCP URL

  isVerified         Boolean  @default(false)
  isProfileCompleted Boolean  @default(false)
  role               Role     @default(USER)

  createdAt          DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workers Worker[]
}

model Category {
  id            String        @id
  name          String
  subCategories SubCategory[]
  workers       Worker[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
}

model SubCategory {
  id         String    @id
  categoryId String
  name       String
  category   Category  @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model Worker {
  id              String    @id
  userId          String
  mobile          String
  firstName       String?
  lastName        String?
  gender          String?
  dateOfBirth     DateTime?
  country         String?
  state           String?
  district        String?
  branch          String?
  latitude        Float?
  longitude       Float?
  profileImage    String?
  categoryId      String
  aadhaarImageUrl String?
  subCategoryIds  String[]
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@map("worker")
}
