generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "business", "commerce"]
}

enum Role {
  USER
  SUPER_ADMIN
  WORKER
  ADMIN

  @@schema("public")
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

enum PropertyType {
  ROOM
  PG
  FLAT
  HOUSE
  OFFICE
  SHOP

  @@schema("public")
}

enum VehicleType {
  BIKE
  AUTO
  PICKUP
  MINI_TRUCK
  TRUCK
  TRACTOR
  JCB

  @@schema("public")
}

enum AddressType {
  HOME
  WORK
  OTHER

  @@schema("public")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED

  @@schema("commerce")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@schema("commerce")
}

enum PaymentMethod {
  COD
  ONLINE

  @@schema("commerce")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  SEEN

  @@schema("public")
}

model User {
  id                 String    @id
  mobile             String    @unique
  firstName          String?
  lastName           String?
  gender             String?
  dateOfBirth        DateTime?
  branchDetails      Json?
  profileImage       String?

  isVerified         Boolean   @default(false)
  isProfileCompleted Boolean   @default(false)
  role               Role      @default(USER)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workers    Worker[]
  chatRooms  ChatRoom[]
  businesses Business[]
  houses     House[]
  vehicles   Vehicle[]
  stores     Store[]
  addresses  UserAddress[]
  carts      Cart[]
  orders     Order[]

  @@map("user")
  @@schema("public")
}

model Business {
  id           String         @id
  userId       String
  categoryId   String
  name         String
  description  String
  contactPhone String
  logoUrl      String
  branch       String?
  latitude     Float?
  longitude    Float?
  status       BusinessStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category BusinessCategory @relation(fields: [categoryId], references: [id])
  stores   Store[]

  @@index([userId])
  @@index([categoryId])
  @@map("business")
  @@schema("public")
}

model BusinessCategory {
  id         String     @id
  name       String
  iconUrl    String?
  sortOrder  Int?
  businesses Business[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  @@index([sortOrder])
  @@index([deletedAt])
  @@map("business_category")
  @@schema("public")
}

model House {
  id                  String         @id
  userId              String
  title               String
  propertyType        PropertyType
  houseType           String?
  description         String?
  monthlyRent         Float
  securityDeposit     Float?
  maintenanceCharges  Float?
  ownerName           String?
  mobileNumber        String?
  photoUrl            String
  branch              String?
  latitude            Float?
  longitude           Float?
  status              BusinessStatus @default(PENDING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("house")
  @@schema("public")
}

model Vehicle {
  id          String         @id
  userId      String
  title       String
  vehicleType VehicleType
  description String?
  photoUrls   String[]
  branch      String?
  latitude    Float?
  longitude   Float?
  status      BusinessStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("vehicle")
  @@schema("public")
}

model WorkerCategory {
  id            String              @id
  name          String
  iconUrl       String?
  sortOrder     Int?
  subCategories WorkerSubCategory[]
  workers       Worker[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([sortOrder])
  @@index([deletedAt])
  @@map("worker_category")
  @@schema("public")
}

model WorkerSubCategory {
  id         String         @id
  categoryId String
  name       String
  iconUrl    String?
  sortOrder  Int?
  category   WorkerCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  @@index([categoryId])
  @@index([categoryId, sortOrder])
  @@index([deletedAt])
  @@map("worker_subcategory")
  @@schema("public")
}

model Worker {
  id              String    @id
  userId          String
  mobile          String
  firstName       String?
  lastName        String?
  gender          String?
  dateOfBirth     DateTime?
  branch          String?
  latitude        Float?
  longitude       Float?
  profileImage    String?
  categoryId      String
  aadhaarImageUrl String?
  subCategoryIds  String[]
  experienceYears Int?
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  WorkerCategory @relation(fields: [categoryId], references: [id])
  chatRooms ChatRoom[]

  @@index([userId])
  @@index([categoryId])
  @@map("worker")
  @@schema("public")
}

model ChatRoom {
  id        String   @id
  userId    String
  workerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Denormalized conversation preview, kept up to date by the message-save
  // worker so the rooms list is a single indexed read (no per-room join).
  lastMessageId      String?
  lastMessageContent String?
  lastMessageSenderId String?
  lastMessageAt      DateTime?

  // Per-side unread counters maintained asynchronously by the status worker.
  userUnreadCount   Int @default(0)
  workerUnreadCount Int @default(0)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker   Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userId, workerId])
  @@index([userId])
  @@index([workerId])
  @@index([lastMessageAt(sort: Desc)])
  @@map("chat_room")
  @@schema("public")
}

model ChatMessage {
  id          String        @id
  roomId      String
  senderId    String
  receiverId  String
  content     String
  status      MessageStatus @default(SENT)
  deliveredAt DateTime?
  seenAt      DateTime?
  createdAt   DateTime      @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([receiverId, status])
  @@map("chat_message")
  @@schema("public")
}

model UserAddress {
  id            String      @id
  userId        String
  name          String
  contactNumber String
  houseNo       String?
  addressLine   String
  addressType   AddressType @default(HOME)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  carts Cart[]

  @@index([userId])
  @@map("user_address")
  @@schema("public")
}

model Store {
  id          String   @id
  userId      String
  businessId  String
  name        String
  description String?
  openTime    String?
  closeTime   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([userId])
  @@index([businessId])
  @@map("store")
  @@schema("business")
}

model Product {
  id          String   @id
  storeId     String
  name        String
  description String?
  price       Float
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("product")
  @@schema("business")
}

model Cart {
  id                String   @id
  userId            String   @unique
  deliveryAddressId String?
  totalPrice        Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryAddress UserAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           CartItem[]

  @@index([userId])
  @@map("cart")
  @@schema("commerce")
}

model CartItem {
  id          String   @id
  cartId      String
  productId   String
  productName String
  quantity    Int      @default(1)
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_item")
  @@schema("commerce")
}

model Order {
  id              String        @id
  userId          String
  deliveryAddress Json
  totalPrice      Float
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
  @@map("order")
  @@schema("commerce")
}

model OrderItem {
  id          String   @id
  orderId     String
  productId   String
  productName String
  quantity    Int
  price       Float
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_item")
  @@schema("commerce")
}
